From b050a2041b605a93cbba87b83eda6199728d4f12 Mon Sep 17 00:00:00 2001
From: Sreyneathkaem <sk6024010075@camtech.edu.kh>
Date: Tue, 8 Sep 2026 02:05:54 +0000
Subject: [PATCH] Implement security measures (closes #5)

- Add helmet for secure HTTP headers (HSTS, X-Content-Type-Options, etc.)
- Stop leaking refresh tokens in login/refresh JSON response bodies;
  they should only ever live in the httpOnly cookie
- Stop passing access token and user profile in the Google OAuth
  redirect URL query string (frontend already gets both via the
  existing POST /auth/google/callback flow, so this was dead code
  and a pure leak vector)
- Gate /login-demo and /debug-sentry behind NODE_ENV !== production
- Add .github/dependabot.yml for automated weekly dependency scanning
  on both backend and frontend
---
 .github/dependabot.yml                        | 13 ++++++++++++
 .../auth/google-callback.controller.ts        | 14 ++++++-------
 backend/controllers/auth/login.controller.ts  |  3 +--
 .../auth/refresh-token.controller.ts          |  3 +--
 backend/index.ts                              | 20 ++++++++++++-------
 backend/package-lock.json                     | 13 ++++++++++++
 backend/package.json                          |  1 +
 7 files changed, 48 insertions(+), 19 deletions(-)
 create mode 100644 .github/dependabot.yml

diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 0000000..d659a25
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,13 @@
+version: 2
+updates:
+  - package-ecosystem: "npm"
+    directory: "/backend"
+    schedule:
+      interval: "weekly"
+    open-pull-requests-limit: 10
+
+  - package-ecosystem: "npm"
+    directory: "/frontend"
+    schedule:
+      interval: "weekly"
+    open-pull-requests-limit: 10
